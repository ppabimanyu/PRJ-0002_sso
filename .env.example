# Backend
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Isi hanya jika backend berada di belakang reverse proxy tepercaya.
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m
# Sesi SSO: idle 30 hari, absolut 90 hari.
SESSION_IDLE_TTL=720h
SESSION_ABSOLUTE_TTL=2160h
# Login: 10 kegagalan per 15 menit per akun + IP.
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW=15m
# Admin pertama dibuat saat start jika email ini belum ada.
# Password hanya dipakai saat pembuatan; setelah itu boleh dikosongkan.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
LOG_LEVEL=info
# Kosong berarti export OTLP dimatikan. `make observability` mengisi nilai ini.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=sso-api
OTEL_TRACES_SAMPLER_ARG=1.0
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576

# Frontend, dibaca saat build. Kosong berarti same-origin.
# Isi origin penuh (mis. https://auth.example.com) hanya jika API beda origin.
VITE_API_URL=
# Nama service di wordmark dan judul dokumen. Ganti per project.
VITE_APP_NAME=SSO
# Set `true` lalu build ulang untuk menampilkan halaman maintenance di semua route.
VITE_MAINTENANCE_MODE=false
